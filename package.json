{
  "name": "anyworker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @anyworker/web dev",
    "dev:web": "pnpm --filter @anyworker/web dev",
    "dev:gui": "pnpm --filter @anyworker/gui dev",
    "dev:server": "cd apps/anyworker/server && uv run anyworker-server",
    "build": "pnpm --filter @anyworker/web build",
    "build:web": "pnpm --filter @anyworker/web build",
    "build:gui": "pnpm --filter @anyworker/gui build",
    "deploy:web": "pnpm --filter @anyworker/web run deploy",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "unrs-resolver",
      "lightningcss",
      "sharp"
    ]
  }
}
